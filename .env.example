# Copie este arquivo para `.env` e preencha os valores. Nunca commite `.env`.
# Guia completo: claude/backend-activation-plan.md

# ── App ──────────────────────────────────────────────────────────────────────
# ID da linha de configuração global (GlobalSettings). Só é necessário quando a
# tela admin de configurações for usada; pode deixar vazio por enquanto.
GLOBAL_CONFIG_ID=""

# ── Supabase (auth / SSR) ────────────────────────────────────────────────────
# Painel Supabase → Settings → API.
# Project URL:
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# Chave "anon" / "public" (NÃO a service_role):
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# ── Banco de dados (Prisma → Postgres no Supabase) ───────────────────────────
# Painel Supabase → Settings → Database → Connection string (ou botão Connect).
# Troque USER/PASSWORD/HOST pelos valores do seu projeto.
# Pooler (Transaction), porta 6543, com ?pgbouncer=true — usado em runtime:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Conexão direta, porta 5432 — usada pelo `prisma db push`:
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── E-mail do formulário /contato (nodemailer / SMTP) ────────────────────────
# Não vem do Supabase — vem do provedor de e-mail.
# Porta 465 = TLS (secure); outras (ex.: 587) = STARTTLS.
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
# Usuário/remetente SMTP:
SMTP_USER="no-reply@your-domain.com"
# Gmail: use uma App Password (senha de app), NÃO a senha da conta:
SMTP_PASS="your-smtp-password"
# Caixa que recebe as notificações do formulário:
CONTACT_EMAIL_DESTINATION="contato@your-domain.com"

# ── Analytics / Google Tag Manager ──────────────────────────────────────────
# Único ponto de medição: GA4, Clarity e demais tags são configurados DENTRO do
# container GTM (web UI), não no código. Container ID (GTM-…) público; já vem
# com o ID real como padrão no código. Preencha aqui só para sobrescrever.
NEXT_PUBLIC_GTM_ID=""

# QA (dev): "1" renderiza SÓ a UI do banner de consentimento no localhost, sem
# ligar o GTM/Consent Mode (que seguem restritos à produção). Deixe vazio em
# produção. Use para pré-visualizar o texto/visual do banner localmente.
NEXT_PUBLIC_CONSENT_PREVIEW=""

# ── Pix da conferência (página /conferencia) ────────────────────────────────
# Chave Pix da igreja, do jeito que ela está cadastrada no banco (CNPJ, e-mail,
# telefone ou chave aleatória). SEM valor padrão de propósito: enquanto estiver
# vazia, a inscrição é recusada com recado em vez de gerar um código que paga
# para a conta errada.
PIX_KEY=""
# Nome e cidade do recebedor, como aparecem no app de quem paga. Até 25 e 15
# caracteres, sem acento. Se não preencher, vale "IGREJA REFORMADA"/"BRASILIA".
PIX_MERCHANT_NAME=""
PIX_MERCHANT_CITY=""


# ── Aviso de inscrição no WhatsApp (CallMeBot) ──────────────────────────────
# Cada número é autorizado uma vez, conversando com o bot do CallMeBot, que
# responde com uma chave. Aqui vão o telefone (com código do país, só dígitos)
# e essa chave. Para avisar dois celulares, vírgula nas duas variáveis, na
# mesma ordem. Vazias, nenhum aviso sai e a inscrição funciona igual.
WHATSAPP_ALERT_PHONE=""
WHATSAPP_ALERT_APIKEY=""

# ── Meta Conversions API (envio do evento pelo servidor) ────────────────────
# O pixel do navegador perde conversão (bloqueador, Safari, aba fechada antes
# da tag disparar). Estas variáveis ligam o envio do MESMO evento pelo
# servidor, em lib/meta-capi.ts. Vazias, nada é enviado e o site funciona
# igual: só a medição fica dependendo do navegador.
#
# ID do pixel. É PÚBLICO (vai no HTML de toda página); o código já traz o da
# igreja como padrão. Preencha só para sobrescrever.
META_PIXEL_ID=""
# Token de acesso da Conversions API. É SEGREDO: gere no Gerenciador de
# Eventos do Meta (Configurações do conjunto de dados → Conversions API →
# Gerar token de acesso) e cole AQUI e na Vercel, nunca em chat nem em commit.
META_CAPI_TOKEN=""
# Versão da Graph API. Vazia, vale "v26.0", a mais nova aceita em 29/10/2026.
META_CAPI_API_VERSION=""
# Só para testar: com um código daqui (Gerenciador de Eventos → Eventos de
# teste), o evento aparece naquela aba em vez de contar como conversão real.
# DEIXE VAZIO em produção.
META_CAPI_TEST_EVENT_CODE=""

# ── Convite de usuário do painel (tela /admin/usuarios) ─────────────────────
# A chave secreta do Supabase, a ÚNICA que pode criar usuário. Ela ignora toda
# política de acesso do banco: NUNCA vai para o navegador, nunca entra em
# commit, nunca é colada em chat. Preencha aqui e na Vercel.
#
# Onde fica: Painel Supabase → Project Settings → API Keys. Duas formas valem
# aqui, e o código aceita as duas do mesmo jeito:
#   1. aba "Legacy API Keys" → a chave `service_role` (um JWT longo);
#   2. a chave nova do tipo "secret", que começa com `sb_secret_`. É a que
#      substitui a de cima, porque o Supabase aposenta a `service_role` até o
#      fim de 2026. Se o projeto ainda não tiver nenhuma, dá para criar ali.
# O que NÃO serve: a `anon` nem a `publishable`, que são as chaves públicas.
# Vazia, a tela de usuários abre e explica o que falta, sem criar ninguém.
SUPABASE_SERVICE_ROLE_KEY=

# Quem é o dono do painel: a única conta que vê a tela de usuários e convida
# gente nova. Vazia, vale igrejareformadabrasilia@gmail.com, que está no
# código (utils/dono.ts). Preencha só para trocar o dono.
ADMIN_OWNER_EMAIL=
