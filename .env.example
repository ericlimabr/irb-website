# Copy this file to `.env` and fill in the values. Never commit `.env`.

# ── Database (Prisma → Postgres, hosted on Supabase) ─────────────────────────
# DATABASE_URL: pooled connection used by the app at runtime.
# DIRECT_URL:   direct connection used for schema changes (`prisma db push`).
# From Supabase: Project Settings → Database → Connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Supabase (auth / SSR) ────────────────────────────────────────────────────
# Public — safe to expose to the browser. From Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# ── Contact form email (nodemailer / SMTP) ───────────────────────────────────
# The /contato form saves to the DB and emails a notification via these.
# SMTP_PORT 465 is treated as secure (TLS); anything else (e.g. 587) as STARTTLS.
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_USER="no-reply@your-domain.com"
SMTP_PASS="your-smtp-password"
# Inbox that receives contact-form notifications.
CONTACT_EMAIL_DESTINATION="contato@your-domain.com"

# ── App config ───────────────────────────────────────────────────────────────
# Id of the global site-config row read by the app.
GLOBAL_CONFIG_ID="your-global-config-id"
