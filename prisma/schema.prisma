generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GlobalSettings {
  id        String   @id @default(uuid())
  updatedAt DateTime @default(now()) @updatedAt

  // --- IDENTITY AND BRAND ---
  siteName    String  @default("Igreja Cristã Reformada")
  siteTagline String?
  logoUrl     String?
  faviconUrl  String?

  // --- AUTHOR INFORMATION ---
  authorName      String  @default("Igreja Cristã Reformada")
  authorBio       String? @db.Text
  authorAvatarUrl String?

  // --- SOCIAL NETWORKS ---
  socialWhatsApp  String?
  socialLinkedin  String?
  socialX         String?
  socialInstagram String?
  socialFacebook  String?
  socialYoutube   String?

  // --- SEO ---
  metaTitle         String?
  metaDescription   String? @db.Text
  ogImageUrl        String?
  googleAnalyticsId String?

  // --- BLOG PREFERENCES ---
  postsPerPage        Int     @default(9)
  enableComments      Boolean @default(false)
  maintenanceMode     Boolean @default(false)
  customScriptsHead   String? @db.Text
  customScriptsFooter String? @db.Text

  // --- FOOTER AND CONTACT ---
  footerText   String? @default("© Todos os direitos reservados.")
  contactEmail String?
  contactPhone String?
}

enum UserRole {
  ADMIN
  EDITOR
  USER
}

model User {
  id    String   @id @default(uuid())
  email String   @unique
  name  String?
  role  UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum PostType {
  ARTICLE
  VIDEO
  STUDY
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id         String     @id @default(uuid())
  title      String
  slug       String     @unique
  content    String     @db.Text
  excerpt    String?    @db.Text
  coverImage String?
  status     PostStatus @default(DRAFT)
  type       PostType   @default(ARTICLE)

  authorId   String?
  authorName String

  tags Tag[] @relation("PostToTag")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@map("posts")
}

model Tag {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  posts Post[] @relation("PostToTag")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tags")
}

model ContactMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name     String
  email    String
  whatsapp String
  subject  String
  message  String @db.Text

  read    Boolean @default(false)
  replied Boolean @default(false)

  @@map("contact_messages")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

/// Medição do banner de consentimento (LGPD), a única fonte de sinal para
/// tráfego que ainda NÃO consentiu — GA4/Clarity/pixel só veem quem aceita.
/// Registro é agregado e SEM PII: nada de IP, User-Agent cru ou identificador
/// que reconheça a pessoa (isso viraria rastreamento e exigiria consentimento).
/// Só o tipo do clique + contexto grosseiro, permitido por interesse legítimo
/// (medir o próprio mecanismo de consentimento).
model ConsentEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  type     String // "shown" | "accept" | "reject"
  source   String? // "campaign" | "organic"
  campaign String? // utm_campaign, quando presente
  device   String? // "mobile" | "tablet" | "desktop"
  inApp    Boolean @default(false) // navegador in-app do FB/IG (WebView)
  country  String? // país (ISO) derivado do edge, sem guardar o IP
  path     String? // rota onde o banner apareceu

  @@index([type])
  @@index([source])
  @@map("consent_events")
}

enum InscricaoStatus {
  AGUARDANDO
  PAGA
  CANCELADA
}

enum InscricaoDias {
  AMBOS
  SABADO
  DOMINGO
}

enum InscricaoVinculo {
  MEMBRO
  OUTRA_IGREJA
  CONVIDADO
  SEM_IGREJA
}

/// Como a pessoa ficou sabendo da conferência. Sem valor padrão de propósito:
/// a coluna é anulável e quem não responde fica nulo, porque um padrão aqui
/// contaria como divulgação o que foi só a primeira opção da lista.
enum InscricaoComoSoube {
  IGREJA
  CONVITE
  INSTAGRAM
  YOUTUBE
  WHATSAPP
  GOOGLE
  OUTRO
}

/// Inscrição na 2ª Conferência Reformada (7 e 8 de novembro de 2026).
///
/// O pagamento é Pix sem intermediário: não há webhook que confirme nada, e a
/// conciliação é feita a olho no extrato da igreja, PELO NOME DE QUEM PAGA.
///
/// `centavos` é fixo em 7 e igual em toda inscrição: marca que o Pix é da
/// conferência, e não identifica ninguém. `txid` leva o número da inscrição
/// dentro do BR Code, e alguns bancos o repassam a quem recebe, o que ajuda
/// mas não serve de garantia. Por isso o formulário pergunta o nome do
/// pagador quando o Pix sai da conta de outra pessoa.
model Inscricao {
  id        String   @id @default(uuid())
  numero    Int      @unique @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nome     String
  email    String
  whatsapp String

  /// 12 anos ou mais, que pagam; e até 11 anos, que não pagam.
  adultos  Int @default(1)
  criancas Int @default(0)

  dias    InscricaoDias    @default(AMBOS)
  vinculo InscricaoVinculo @default(MEMBRO)

  /// Qual igreja, perguntado só quando o vínculo é OUTRA_IGREJA. Em qualquer
  /// outro vínculo o formulário não mostra o campo e o servidor grava nulo,
  /// para não guardar resposta de pergunta que não foi feita.
  igreja String?

  /// De onde veio a notícia da conferência, quando a pessoa informa.
  comoSoube InscricaoComoSoube?

  /// Nome de quem faz o Pix, quando não é a própria pessoa inscrita.
  pagador String?

  /// Identificação no extrato, 1 a 99, e o total em centavos (adultos × 2000
  /// + centavos). Centavo em ponto flutuante arredonda errado, então o valor
  /// nunca é gravado como real.
  /// Preenchidos logo depois do insert, quando `numero` já existe: é dele que
  /// sai a identificação. Por isso nascem zerados e o txid nasce nulo.
  centavos Int     @default(0)
  valor    Int     @default(0)
  txid     String? @unique

  status     InscricaoStatus @default(AGUARDANDO)
  pagoEm     DateTime?
  /// Quando o lembrete da véspera foi enviado, para não enviar duas vezes.
  lembreteEm DateTime?
  /// Sobra da planilha do Google Drive, trocada em 18/10/2026 pela exportação
  /// em Excel na tela do admin. Nada escreve nem lê esta coluna; ela continua
  /// no banco porque apagar coluna é destrutivo e ninguém pediu.
  planilhaEm DateTime?

  @@index([status])
  @@index([valor])
  @@map("inscricoes")
}
